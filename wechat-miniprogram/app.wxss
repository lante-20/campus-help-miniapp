/* app.wxss  校园简约风 浅蓝主色 */
page {
  --blue: #4A90E2;
  --blue-soft: #E8F1FC;
  --bg: #F4F7FB;
  --line: #EDF0F5;
  --text: #1f2d3d;
  --muted: #8a94a6;
  background: var(--bg);
  color: var(--text);
  font-size: 15px;
}
.card {
  background: #fff;
  border-radius: 14px;
  padding: 16px;
  margin: 12px 14px;
  box-shadow: 0 2px 10px rgba(74,144,226,.06);
}
.row { display: flex; align-items: center; justify-content: space-between; }
.tag { display:inline-block; font-size:12px; padding:2px 8px; border-radius:6px; background:var(--blue-soft); color:var(--blue); margin-right:6px;}
.reward { color:#ff8a3d; font-size:12px; }
.btn { background:var(--blue); color:#fff; border:none; border-radius:10px; padding:12px; width:100%; font-size:16px;}
.btn[disabled] { background:#b9d4f5; }
.btn.ghost { background:#fff; color:var(--blue); border:1px solid var(--blue);}
.muted { color:var(--muted); font-size:12.5px;}
.chip { display:inline-block; padding:6px 14px; border-radius:16px; background:#fff; font-size:13px; margin-right:8px; color:var(--muted);}
.chip.active { background:var(--blue); color:#fff;}
.field { margin:14px; }
.field label { display:block; font-size:13px; color:var(--muted); margin-bottom:6px;}
.field input { width:100%; height:48px; line-height:48px; background:#fff; border-radius:10px; padding:0 12px; border:1px solid var(--line); box-sizing:border-box;}
.field textarea { width:100%; height:140px; background:#fff; border-radius:10px; padding:12px; border:1px solid var(--line); box-sizing:border-box;}
.state { padding:28px 18px; text-align:center; color:#68798b; line-height:1.7; }
.state button { display:block; margin:10px auto 0; }
.error { color:#b34336; }
.demo-note { margin:12px 14px; padding:10px 12px; border-radius:8px; background:#e8f1fc; color:#395d87; font-size:12px; line-height:1.7; }
.actions { margin:18px; padding-bottom:env(safe-area-inset-bottom); }
.actions .btn + .btn, .dialog .btn + .btn { margin-top:12px; }
.load-more { display:block; margin:16px auto 28px; }
.link { color:#286bb3; padding:4px; }
.kv > text:last-child { margin-left:12px; text-align:right; overflow-wrap:break-word; word-break:break-all; }
.row > text { min-width:0; overflow-wrap:break-word; }
