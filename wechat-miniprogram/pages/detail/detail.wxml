<view class="card">
  <view class="row">
    <text class="tag">{{typeLabel}}</text>
    <text wx:if="{{t.reward}}" class="reward">报酬 {{t.reward}}</text>
    <text class="muted" style="margin-left:auto">{{statusText}}</text>
  </view>
  <view class="tt">{{t.item || t.pickup}}</view>
  <view wx:if="{{t.item}}" class="kv"><text class="k">要拿的东西</text><text>{{t.item}}</text></view>
  <view wx:if="{{t.weight}}" class="kv"><text class="k">重量</text><text>{{t.weight}}</text></view>
  <view class="kv"><text class="k">取件地点</text><text>{{t.pickup}}</text></view>
  <view class="kv"><text class="k">送达地址</text><text>{{t.building}}</text></view>
  <view class="kv"><text class="k">截止时间</text><text>{{t.deadline}}</text></view>
  <view wx:if="{{t.remark}}" class="remark">{{t.remark}}</view>
</view>
<view class="card" bindtap="viewPub">
  <view class="kv"><text class="k">发布者</text><text style="color:#4A90E2">{{t.pubName}} ›</text></view>
  <view class="kv"><text class="k">微信号</text><text bindtap="copyWechat">{{t.pubWechat}}(点我复制)</text></view>
</view>
<view style="margin:18px">
  <button wx:if="{{!isPub && t.status!=='ongoing'}}" class="btn" bindtap="goAccept">报名接单</button>
  <button wx:if="{{t.status==='ongoing'}}" class="btn" bindtap="contact">联系对方</button>
  <button wx:if="{{isPub && t.status!=='done'}}" class="btn ghost" bindtap="finishTask">结束任务</button>
</view>
