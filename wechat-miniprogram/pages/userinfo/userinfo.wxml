<view class="card">
  <view class="muted">以下资料仅保存到本机演示账号，不会附带到新发布的任务中。请使用虚构信息。</view>
  <view class="kvrow"><text class="k">昵称</text><text>{{info.nick}}</text></view>
  <view class="kvrow"><text class="k">演示账号</text><text>{{info.wechat}}</text></view>
</view>
<view class="field"><label>称呼（选填）</label><input data-f="realName" maxlength="60" placeholder="例：陈同学" value="{{info.realName}}" bindinput="onIn"/></view>
<view class="field"><label>学院 / 专业（选填）</label><input data-f="college" maxlength="60" placeholder="例：示例学院" value="{{info.college}}" bindinput="onIn"/></view>
<view class="field"><label>年级（选填）</label><input data-f="grade" maxlength="60" placeholder="例：2026 级" value="{{info.grade}}" bindinput="onIn"/></view>
<view class="field"><label>常用楼栋（选填）</label><input data-f="building" maxlength="60" placeholder="请填虚构楼栋" value="{{info.building}}" bindinput="onIn"/></view>
<view class="actions"><button class="btn" disabled="{{saving}}" loading="{{saving}}" bindtap="save">保存</button></view>
