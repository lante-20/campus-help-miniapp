.wrap{padding:40px 28px;text-align:center}
.logo{width:72px;height:72px;border-radius:20px;background:linear-gradient(135deg,#5B9BE8,#4A90E2);color:#fff;font-size:34px;font-weight:700;display:flex;align-items:center;justify-content:center;margin:0 auto 16px}
.t{font-size:19px;font-weight:700}
.s{font-size:12.5px;color:#8a94a6;margin:6px 0 28px}
.avatar{width:84px;height:84px;border-radius:50%;background:#fff;border:1px solid #E3EAF5;margin:0 auto 18px;padding:0;line-height:84px;overflow:hidden}
.avimg{width:84px;height:84px;border-radius:50%}
.avph{font-size:12px;color:#8a94a6}
.inp{background:#fff;border:1px solid #EDF0F5;border-radius:10px;padding:13px;margin-bottom:12px;text-align:left}
.btn{background:#4A90E2;color:#fff;border-radius:10px;margin-top:8px}
.btn.phone{background:#fff;color:#4A90E2;border:1px solid #4A90E2}
.tip{font-size:11.5px;color:#9aa5b1;margin-top:16px;line-height:1.6}
