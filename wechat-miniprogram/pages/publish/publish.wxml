<view class="demo-note">本机演示：请使用虚构信息，可在“我的”切换账号体验接单。</view>
<view wx:if="{{draftError}}" class="state error">{{draftError}}</view>
<view class="field"><label>任务类型</label>
  <picker range="{{types}}" range-key="label" value="{{typeIdx}}" bindchange="onType">
    <view class="picker">{{types[typeIdx].label}} ▾</view>
  </picker>
</view>
<view class="field"><label class="req">{{type==='lost' ? '遗失 / 拾获的物品名称' : '要拿的物品'}}</label><input data-f="item" maxlength="80" placeholder="例：蓝色雨伞 / 一份外卖" value="{{item}}" bindinput="onIn"/></view>
<view class="field"><label class="req">{{type==='lost' ? '遗失 / 拾获地点' : '取件地点'}}</label><input data-f="pickup" maxlength="100" placeholder="例：图书馆一楼" value="{{pickup}}" bindinput="onIn"/></view>
<block wx:if="{{type!=='lost'}}">
  <view class="field"><label class="req">送达地址（仅任务双方在页面中可见）</label><input data-f="building" maxlength="100" placeholder="请使用虚构地址" value="{{building}}" bindinput="onIn"/></view>
  <view class="field"><label>取件码（选填，仅任务双方在页面中可见）</label><input data-f="pickupCode" maxlength="40" placeholder="演示时请勿填写真实取件码" value="{{pickupCode}}" bindinput="onIn"/></view>
  <view class="field"><label>重量（选填）</label><input data-f="weight" maxlength="30" placeholder="例：约 2 kg" value="{{weight}}" bindinput="onIn"/></view>
  <view class="field"><label class="req">截止日期</label><picker mode="date" start="{{today}}" value="{{deadlineDate}}" data-f="deadlineDate" bindchange="onIn"><view class="picker">{{deadlineDate || '请选择日期'}}</view></picker></view>
  <view class="field"><label class="req">截止时间</label><picker mode="time" value="{{deadlineTime}}" data-f="deadlineTime" bindchange="onIn"><view class="picker">{{deadlineTime || '请选择时间'}}</view></picker></view>
  <view class="field"><label class="req">报酬金额（元，0 表示无偿）</label><input type="digit" data-f="reward" maxlength="7" placeholder="例：5.00，仅演示展示" value="{{reward}}" bindinput="onIn"/></view>
</block>
<block wx:else>
  <view class="field"><label class="req">遗失 / 拾获日期</label><picker mode="date" end="{{today}}" value="{{eventDate}}" data-f="eventDate" bindchange="onIn"><view class="picker">{{eventDate || '请选择日期'}}</view></picker></view>
  <view class="field"><label class="req">遗失 / 拾获时间</label><picker mode="time" value="{{eventTime}}" data-f="eventTime" bindchange="onIn"><view class="picker">{{eventTime || '请选择时间'}}</view></picker></view>
</block>
<view class="field"><label>{{type==='lost' ? '物品特征及遗失 / 拾获说明（必填）' : '备注（选填）'}}</label><textarea data-f="remark" maxlength="500" placeholder="公开描述中请勿填写取件码、手机号等信息" value="{{remark}}" bindinput="onIn"/></view>
<view class="actions">
  <button class="btn" loading="{{saving}}" disabled="{{saving}}" bindtap="submit">发布任务</button>
  <button class="btn ghost" disabled="{{saving}}" bindtap="saveDraft">保存草稿</button>
</view>
<view wx:if="{{showWarn}}" class="mask">
  <view class="dialog">
    <view class="dt">确认发布演示任务</view>
    <view class="dd">任务仅保存在当前设备。物品名称、取件地点和描述会展示给本机的其他演示账号。请使用虚构信息，不要填入真实手机号、取件码或个人地址。</view>
    <button class="btn" bindtap="confirmWarn">确认发布</button>
    <button class="btn ghost" bindtap="cancelWarn">继续编辑</button>
  </view>
</view>
