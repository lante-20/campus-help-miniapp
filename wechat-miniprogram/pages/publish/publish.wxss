.picker{background:#fff;border:1px solid #EDF0F5;border-radius:10px;padding:12px}
.req::after{content:' *';color:#ff6b6b}
.mask{position:fixed;inset:0;background:rgba(0,0,0,.45);display:flex;align-items:center;justify-content:center;z-index:99}
.dialog{background:#fff;border-radius:16px;width:82%;padding:20px}
.dt{font-size:17px;font-weight:700;margin-bottom:10px}
.dd{font-size:13.5px;color:#556;line-height:1.7;margin-bottom:14px;max-height:300px;overflow:auto}
