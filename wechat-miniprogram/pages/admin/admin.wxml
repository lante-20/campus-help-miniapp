<view class="demo-note">举报处理流程演示：仅展示本机记录，尚未连接管理员服务。</view>
<view wx:if="{{loading}}" class="state">正在加载…</view>
<view wx:elif="{{error}}" class="state error">{{error}}<button size="mini" bindtap="load">重试</button></view>
<view wx:elif="{{reports.length===0}}" class="state">暂无本机举报记录</view>
<view wx:for="{{reports}}" wx:key="_id" class="card">
  <view>{{item.reason}}</view>
  <view class="muted">举报账号：{{item.reporterWx}} · 被举报账号：{{item.targetWx}}</view>
  <view class="muted">状态：仅本机保存，未提交到云端</view>
</view>
