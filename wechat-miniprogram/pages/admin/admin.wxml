<view class="muted" style="padding:12px 16px">举报记录</view>
<view wx:if="{{reports.length===0}}" class="muted" style="text-align:center;padding:40px 0">暂无举报</view>
<view wx:for="{{reports}}" wx:key="_id" class="card">
  <view style="font-weight:600">{{item.reason}}</view>
  <view class="muted" style="margin-top:6px">举报人: {{item.reporterWx}}　被举报: {{item.targetWx}}</view>
</view>
