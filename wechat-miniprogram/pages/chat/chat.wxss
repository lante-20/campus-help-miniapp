page{height:100%;display:flex;flex-direction:column}
.warn{background:#FFF7E6;color:#925500;font-size:12px;padding:8px 12px;flex-shrink:0}
.list{flex:1;height:0;min-height:0;box-sizing:border-box;padding:12px}
.b{max-width:75%;padding:10px 12px;border-radius:12px;margin-bottom:10px;font-size:14px;word-break:break-all;white-space:pre-wrap}
.mine{background:#4A90E2;color:#fff;margin-left:auto}
.their{background:#fff}
.bar{display:flex;align-items:center;padding:10px;padding-bottom:calc(10px + env(safe-area-inset-bottom));border-top:1px solid #EDF0F5;background:#fff;flex-shrink:0}
.inp{flex:1;min-width:0;background:#F4F7FB;border-radius:20px;padding:10px 14px}
.send{margin-left:8px;background:#4A90E2;color:#fff;border-radius:20px;font-size:14px;line-height:2}
